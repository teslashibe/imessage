+import Foundation
+import SQLite
+
+// SIP-enabled standard tapbacks. The exact-message link and custom action names
+// follow Beeper platform-imessage v0.24.2 (MIT); see the downstream build notes.
+public struct NativeTapback {
+  let store: MessageStore
+  var dispatch: (String, String, String) throws -> Void = Self.dispatchOnce
+  var verificationTimeout: TimeInterval = 8
+
+  public init(store: MessageStore) { self.store = store }
+
+  public func set(chatGUID: String, messageGUID: String, reactionType: Int, partIndex: Int) throws {
+    let removing = (3000...3005).contains(reactionType)
+    let addition = removing ? reactionType - 1000 : reactionType
+    guard partIndex == 0, (2000...2005).contains(addition), UUID(uuidString: messageGUID) != nil
+    else {
+      throw Self.failure(
+        .notStarted, "Native tapbacks require an exact UUID, part zero and a standard reaction.")
+    }
+    let initial = try store.nativeTapbackSnapshot(chatGUID: chatGUID, messageGUID: messageGUID)
+    if Self.satisfied(current: initial.reaction, desired: addition, removing: removing) { return }
+    let titles = [
+      "Heart", "Thumbs up", "Thumbs down", "Ha ha!", "Exclamation mark", "Question mark",
+    ]
+    try dispatch(messageGUID, initial.text, titles[addition - 2000])
+    // Dispatch has happened. Every subsequent failure must preserve uncertainty.
+    do {
+      let deadline = ContinuousClock.now + .seconds(verificationTimeout)
+      repeat {
+        let current = try store.nativeTapbackSnapshot(chatGUID: chatGUID, messageGUID: messageGUID)
+        guard current.rowID == initial.rowID, current.text == initial.text else {
+          throw Self.failure(.mayHaveCompleted, "Target changed while verifying the reaction.")
+        }
+        if Self.satisfied(current: current.reaction, desired: addition, removing: removing) {
+          return
+        }
+        Thread.sleep(forTimeInterval: 0.15)
+      } while ContinuousClock.now < deadline
+    } catch {
+      throw Self.failure(
+        .mayHaveCompleted, "Cannot verify the exact target reaction after dispatch.")
+    }
+    throw Self.failure(
+      .mayHaveCompleted, "Reaction was dispatched but its requested state was not observed.")
+  }
+
+  static func satisfied(current: Int?, desired: Int, removing: Bool) -> Bool {
+    removing ? current != desired : current == desired
+  }
+
+  static func failure(_ disposition: DeliveryDisposition, _ detail: String) -> DeliveryFailure {
+    DeliveryFailure(
+      disposition: disposition, transport: .appleScript, operation: "send-reaction", detail: detail)
+  }
+
+  static func dispatchOnce(_ guid: String, _ text: String, _ title: String) throws {
+    let process = Process()
+    process.executableURL = URL(fileURLWithPath: "/usr/bin/osascript")
+    process.arguments = [
+      "-e", script, "imessage:open?message-guid=" + guid + "&overlay=1", text, title,
+    ]
+    let output = Pipe()
+    process.standardOutput = output
+    process.standardError = FileHandle.nullDevice
+    do { try process.run() } catch {
+      throw failure(.notStarted, "Could not start the native reaction operation.")
+    }
+    if ProcessTimeout.waitUntilExit(process, timeout: 20) {
+      throw failure(.stillInFlight, "Native reaction timed out; do not retry the operation.")
+    }
+    let result = String(data: output.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8)?
+      .trimmingCharacters(in: .whitespacesAndNewlines)
+    guard process.terminationStatus == 0, result == "dispatched" else {
+      throw failure(
+        result == "not_started" ? .notStarted : .mayHaveCompleted,
+        "Native reaction did not return a verified dispatch result.")
+    }
+  }
+
+  // Inputs are argv data, never script source. This script performs one action
+  // at most. No effect retry, keyboard shortcut, latest-message or chat search.
+  static let script = #"""
+    on exactBody(e, expectedText)
+      tell application "System Events"
+        try
+          set contentsList to entire contents of e
+          set matches to 0
+          repeat with i from 1 to count contentsList
+            set childElement to item i of contentsList
+            try
+              if (role of childElement as text) is "AXTextArea" then
+                if (value of childElement as text) is expectedText then set matches to matches + 1
+              end if
+            end try
+          end repeat
+          return matches is 1
+        on error
+          return false
+        end try
+      end tell
+    end exactBody
+
+    on run argv
+      set dispatched to false
+      try
+        set targetURL to item 1 of argv
+        set expectedText to item 2 of argv
+        set actionPrefix to "Name:" & item 3 of argv & linefeed
+        tell application "System Events"
+          tell process "Messages"
+            -- Close any stale reply overlay before opening the exact new target.
+            set es to entire contents of front window
+            repeat with i from 1 to count es
+              set e to item i of es
+              try
+                if (description of e as text) is "Reply transcript" then
+                  set cells to entire contents of e
+                  repeat with j from 1 to count cells
+                    set cell to item j of cells
+                    if (name of every action of cell) contains "AXCancel" then
+                      perform action "AXCancel" of cell
+                      exit repeat
+                    end if
+                  end repeat
+                  exit repeat
+                end if
+              end try
+            end repeat
+          end tell
+        end tell
+        delay 0.2
+        tell application "System Events"
+          tell process "Messages"
+            set es to entire contents of front window
+            repeat with i from 1 to count es
+              set e to item i of es
+              try
+                if (description of e as text) is "Reply transcript" then return "not_started"
+              end try
+            end repeat
+          end tell
+        end tell
+        open location targetURL
+        repeat 30 times
+          delay 0.1
+          tell application "System Events"
+            tell process "Messages"
+              set es to entire contents of front window
+              set candidates to {}
+              set candidateActions to {}
+              repeat with i from 1 to count es
+                set e to item i of es
+                try
+                  if (description of e as text) is "Reply transcript" then
+                    set cells to entire contents of e
+                    repeat with j from 1 to count cells
+                      set cell to item j of cells
+                      try
+                        if (description of cell as text) contains expectedText then
+                          set acts to name of every action of cell
+                          repeat with k from 1 to count acts
+                            set a to item k of acts
+                            if a starts with actionPrefix and my exactBody(cell, expectedText) then
+                              set end of candidates to cell
+                              set end of candidateActions to a
+                            end if
+                          end repeat
+                        end if
+                      end try
+                    end repeat
+                  end if
+                end try
+              end repeat
+              if (count candidates) is 1 then
+                set targetElement to item 1 of candidates
+                set targetAction to item 1 of candidateActions
+                if not (my exactBody(targetElement, expectedText)) then return "not_started"
+                set dispatched to true
+                perform action targetAction of targetElement
+                return "dispatched"
+              end if
+              if (count candidates) > 1 then return "not_started"
+            end tell
+          end tell
+        end repeat
+        return "not_started"
+      on error
+        if dispatched then return "unknown"
+        return "not_started"
+      end try
+    end run
+    """#
+}
+
+struct NativeTapbackSnapshot: Equatable {
+  let rowID: Int64
+  let text: String
+  let reaction: Int?
+}
+
+extension MessageStore {
+  func nativeTapbackSnapshot(chatGUID: String, messageGUID: String) throws -> NativeTapbackSnapshot
+  {
+    guard schema.hasReactionColumns else {
+      throw NativeTapback.failure(.notStarted, "Messages reaction metadata is unavailable.")
+    }
+    return try withConnection { db in
+      let rows = try db.prepareRowIterator(
+        """
+        SELECT m.ROWID AS rowid, IFNULL(m.text, '') AS text
+        FROM message m JOIN chat_message_join j ON j.message_id=m.ROWID
+        JOIN chat c ON c.ROWID=j.chat_id
+        WHERE m.guid=? AND c.guid=? AND c.service_name='iMessage'
+          AND IFNULL(m.associated_message_type,0)=0
+          AND NOT EXISTS (SELECT 1 FROM message_attachment_join a WHERE a.message_id=m.ROWID)
+        """, bindings: [messageGUID, chatGUID])
+      guard let row = try rows.failableNext(), try rows.failableNext() == nil else {
+        throw NativeTapback.failure(
+          .notStarted, "Exact message and chat could not be resolved uniquely.")
+      }
+      let rowID = try int64Value(row, "rowid") ?? 0
+      let text = try stringValue(row, "text")
+      guard !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty, text.utf8.count <= 65536
+      else {
+        throw NativeTapback.failure(
+          .notStarted, "Native tapbacks require a bounded plain-text message.")
+      }
+      // AX has no GUID attribute. A duplicate body could make a stale/wrong
+      // overlay indistinguishable; refuse it rather than guessing a bubble.
+      let duplicates = try db.prepareRowIterator(
+        "SELECT COUNT(*) AS count FROM message WHERE text=?", bindings: [text])
+      guard let count = try duplicates.failableNext(), try int64Value(count, "count") == 1 else {
+        throw NativeTapback.failure(
+          .notStarted, "Message text is ambiguous in the Messages database.")
+      }
+      let events = try db.prepareRowIterator(
+        """
+        SELECT r.associated_message_type AS type
+        FROM message r JOIN chat_message_join j ON j.message_id=r.ROWID
+        JOIN chat c ON c.ROWID=j.chat_id
+        WHERE c.guid=? AND r.is_from_me=1
+          AND r.associated_message_guid IN (?, ?)
+          AND (r.associated_message_type BETWEEN 2000 AND 2006 OR r.associated_message_type BETWEEN 3000 AND 3006)
+        ORDER BY r.date, r.ROWID
+        """, bindings: [chatGUID, messageGUID, "p:0/" + messageGUID])
+      var current: Int?
+      while let event = try events.failableNext() {
+        let type = try intValue(event, "type") ?? 0
+        if type < 3000 { current = type } else if current == type - 1000 { current = nil }
+      }
+      return NativeTapbackSnapshot(rowID: rowID, text: text, reaction: current)
+    }
+  }
+}

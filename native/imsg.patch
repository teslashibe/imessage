diff --git a/Tests/IMsgCoreTests/NativeTapbackTests.swift b/Tests/IMsgCoreTests/NativeTapbackTests.swift
new file mode 100644
index 0000000..d0596d3
--- /dev/null
+++ b/Tests/IMsgCoreTests/NativeTapbackTests.swift
@@ -0,0 +1,157 @@
+import Foundation
+import SQLite
+import Testing
+
+@testable import IMsgCore
+
+private let nativeGUID = "B0BC6779-927C-4C91-8D05-835EBDB67C68"
+private let nativeChat = "iMessage;+;native-fixture"
+
+private func nativeFixture() throws -> (MessageStore, Connection) {
+  let db = try Connection(.inMemory)
+  var options = MessageDatabaseFixture.SchemaOptions()
+  options.includeReactionColumns = true
+  try MessageDatabaseFixture.createSchema(db, options: options)
+  try db.run("INSERT INTO chat(ROWID,guid,service_name) VALUES(1,?,'iMessage')", nativeChat)
+  try db.run(
+    "INSERT INTO message(ROWID,guid,text,date,is_from_me) VALUES(1,?,'unique fixture',1,0)",
+    nativeGUID)
+  try db.run("INSERT INTO chat_message_join(chat_id,message_id) VALUES(1,1)")
+  return (try MessageStore(connection: db, path: ":memory:"), db)
+}
+
+private func event(_ db: Connection, _ row: Int64, _ type: Int) throws {
+  try db.run(
+    "INSERT INTO message(ROWID,associated_message_guid,associated_message_type,date,is_from_me) VALUES(?,?,?,?,1)",
+    row, "p:0/" + nativeGUID, type, row)
+  try db.run("INSERT INTO chat_message_join(chat_id,message_id) VALUES(1,?)", row)
+}
+
+@Test
+func nativeTapbackRefusesWrongChatAndDuplicateTextBeforeDispatch() throws {
+  let (store, db) = try nativeFixture()
+  var calls = 0
+  var client = NativeTapback(store: store)
+  client.dispatch = { _, _, _ in calls += 1 }
+  #expect(throws: DeliveryFailure.self) {
+    try client.set(
+      chatGUID: "iMessage;+;wrong", messageGUID: nativeGUID, reactionType: 2001, partIndex: 0)
+  }
+  try db.run("INSERT INTO message(ROWID,text) VALUES(2,'unique fixture')")
+  #expect(throws: DeliveryFailure.self) {
+    try client.set(chatGUID: nativeChat, messageGUID: nativeGUID, reactionType: 2001, partIndex: 0)
+  }
+  #expect(calls == 0)
+}
+
+@Test
+func nativeTapbackRejectsAttachmentAndUnsupportedPartBeforeDispatch() throws {
+  let (store, db) = try nativeFixture()
+  var client = NativeTapback(store: store)
+  client.dispatch = { _, _, _ in Issue.record("unexpected dispatch") }
+  #expect(throws: DeliveryFailure.self) {
+    try client.set(chatGUID: nativeChat, messageGUID: nativeGUID, reactionType: 2001, partIndex: 1)
+  }
+  try db.run("INSERT INTO message_attachment_join(message_id,attachment_id) VALUES(1,9)")
+  #expect(throws: DeliveryFailure.self) {
+    try client.set(chatGUID: nativeChat, messageGUID: nativeGUID, reactionType: 2001, partIndex: 0)
+  }
+}
+
+@Test
+func nativeTapbackReducesReplacementAndMatchingRemoval() throws {
+  let (store, db) = try nativeFixture()
+  try event(db, 2, 2001)
+  try event(db, 3, 2004)
+  try event(db, 4, 3001)
+  #expect(
+    try store.nativeTapbackSnapshot(chatGUID: nativeChat, messageGUID: nativeGUID).reaction == 2004)
+  try event(db, 5, 3004)
+  #expect(
+    try store.nativeTapbackSnapshot(chatGUID: nativeChat, messageGUID: nativeGUID).reaction == nil)
+}
+
+@Test
+func nativeTapbackAlreadySatisfiedDoesNotToggle() throws {
+  let (store, db) = try nativeFixture()
+  try event(db, 2, 2001)
+  var calls = 0
+  var client = NativeTapback(store: store)
+  client.dispatch = { _, _, _ in calls += 1 }
+  try client.set(chatGUID: nativeChat, messageGUID: nativeGUID, reactionType: 2001, partIndex: 0)
+  try client.set(chatGUID: nativeChat, messageGUID: nativeGUID, reactionType: 3004, partIndex: 0)
+  #expect(calls == 0)
+}
+
+@Test(arguments: [false, true])
+func nativeTapbackDispatchesOnceAndVerifies(removing: Bool) throws {
+  let (store, db) = try nativeFixture()
+  if removing { try event(db, 2, 2001) }
+  var calls = 0
+  var client = NativeTapback(store: store)
+  let type = removing ? 3001 : 2001
+  client.dispatch = { guid, text, title in
+    calls += 1
+    #expect(guid == nativeGUID)
+    #expect(text == "unique fixture")
+    #expect(title == "Thumbs up")
+    try event(db, 3, type)
+  }
+  try client.set(chatGUID: nativeChat, messageGUID: nativeGUID, reactionType: type, partIndex: 0)
+  #expect(calls == 1)
+}
+
+@Test(arguments: [false, true])
+func nativeTapbackNeverRetriesAnUnverifiedDispatch(changed: Bool) throws {
+  let (store, db) = try nativeFixture()
+  var calls = 0
+  var client = NativeTapback(store: store)
+  client.verificationTimeout = 0
+  client.dispatch = { _, _, _ in
+    calls += 1
+    if changed { try db.run("UPDATE message SET text='edited fixture' WHERE ROWID=1") }
+  }
+  do {
+    try client.set(chatGUID: nativeChat, messageGUID: nativeGUID, reactionType: 2001, partIndex: 0)
+    Issue.record("unverified effect returned success")
+  } catch let failure as DeliveryFailure {
+    #expect(failure.disposition == .mayHaveCompleted)
+    #expect(!failure.retrySafe)
+  }
+  #expect(calls == 1)
+}
+
+@Test
+func nativeTapbackPreservesDispatcherUncertainty() throws {
+  let (store, _) = try nativeFixture()
+  var client = NativeTapback(store: store)
+  var calls = 0
+  client.dispatch = { _, _, _ in
+    calls += 1
+    throw NativeTapback.failure(.stillInFlight, "fixture uncertainty")
+  }
+  do {
+    try client.set(chatGUID: nativeChat, messageGUID: nativeGUID, reactionType: 2001, partIndex: 0)
+    Issue.record("uncertain effect returned success")
+  } catch let failure as DeliveryFailure {
+    #expect(failure.disposition == .stillInFlight)
+  }
+  #expect(calls == 1)
+}
+
+@Test
+func nativeTapbackScriptCompilesWithoutExecuting() throws {
+  let dir = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+  try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+  defer { try? FileManager.default.removeItem(at: dir) }
+  let source = dir.appendingPathComponent("fixture.applescript")
+  try NativeTapback.script.write(to: source, atomically: true, encoding: .utf8)
+  let process = Process()
+  process.executableURL = URL(fileURLWithPath: "/usr/bin/osacompile")
+  process.arguments = ["-o", dir.appendingPathComponent("fixture.scpt").path, source.path]
+  process.standardOutput = FileHandle.nullDevice
+  process.standardError = FileHandle.nullDevice
+  try process.run()
+  #expect(!ProcessTimeout.waitUntilExit(process, timeout: 10))
+  #expect(process.terminationStatus == 0)
+}
